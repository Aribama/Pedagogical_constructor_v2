# Скопируйте в backend/.env и заполните. Файл .env в git не попадает.

# Обязательно в продакшене: длинная случайная строка
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True только для локальной разработки
DEBUG=False

ALLOWED_HOSTS=127.0.0.1,localhost
# Полные адреса, с которых открывают сайт, например http://203.0.113.10,https://lesson.example.ru
CSRF_TRUSTED_ORIGINS=
# True, если сайт открывается по HTTPS
SECURE_COOKIES=False

# postgres (по умолчанию) или sqlite для быстрого локального запуска
DB_ENGINE=postgres
DATABASE_NAME=lessonapp_db
DATABASE_USER=lessonapp_user
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Генерация план-конспекта. Без ключа работает встроенный офлайн-генератор.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
