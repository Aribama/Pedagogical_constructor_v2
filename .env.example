# Настройки для docker compose. Скопируйте в .env (это делает ./deploy.sh) и заполните.
# Файл .env в git не попадает.

# Домен сайта, например lesson.example.ru — Caddy сам получит HTTPS-сертификат.
# Оставьте пустым, чтобы сайт открывался по IP сервера по обычному HTTP.
SITE_ADDRESS=

# Длинная случайная строка (deploy.sh сгенерирует сам)
SECRET_KEY=
DATABASE_PASSWORD=

# Адреса, по которым открывают сайт (deploy.sh заполнит по SITE_ADDRESS или IP)
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SECURE_COOKIES=False
BEHIND_HTTPS_PROXY=False

# Ключ DeepSeek. Без него план собирает встроенный офлайн-генератор.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Демо-пользователи teacher и methodist с 16 карточками (1 — создать, 0 — нет)
SEED_DEMO=1
DEMO_PASSWORD=

GUNICORN_WORKERS=3
